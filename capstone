<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Don't Worry Be Happy 💛</title>
  <link href="https://fonts.googleapis.com/css2?family=Gochi+Hand&display=swap" rel="stylesheet">
  <style>
    body {
      background-image: linear-gradient(rgba(0, 0, 0, 0.1),       rgba(0, 0, 0, 0.1)), 
      url      ('https://raw.githubusercontent.com/plsoukhavong-      tech/Lah-Lair/main/Happy%20Face%20BG.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
      margin: 0;
      color: #FA8072;
      font-family: sans-serif;
    }
    .main-wrapper {
      background-color: rgba(255, 255, 255, 0.85); 
      max-width: 1000px;
      margin: 0 auto;
      padding: 30px;
      min-height: 100vh;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }
    header {
      background-color: #F5B027;
      color: white; 
      text-align: center;
      padding: 30px;
      border-radius: 15px;
      margin-bottom: 20px;
    }
    header h1 {
      font-family: 'Gochi Hand', cursive;
      font-size: 55px;
      margin: 0;
    }
    header h2 {
      font-family: 'Gochi Hand', cursive;
      font-size: 30px;
    }
    .table-container {
      display: flex;
      gap: 30px;
      justify-content: center;
      flex-wrap: wrap;
      margin: 30px 0;
    }
    .table-box {
      text-align: center;
    }
    .table-box h3 {
      font-family: 'Gochi Hand', cursive;
      font-size: 32px;
      color: #FA8072;
    }
    table {
      border-collapse: collapse;
      border: 3px solid white;
      width: 320px;
    }
    th {
      background-color: #F5B027;
      color: white;
      padding: 12px;
      border: 2px solid white;
      font-family: 'Gochi Hand', cursive;
      font-size: 24px;
    }
    td {
      background-color: #FA8072;
      color: white;
      padding: 10px;
      border: 1px solid white;
      text-align: center;
      font-size: 18px;
    }
    h2, h3 {
      font-family: 'Gochi Hand', cursive;
    }
    .list-section {
      display: flex;
      justify-content: center;
      gap: 50px;
    }
    .button-transition {
      background-color: white;
      color: #FA8072;
      padding: 12px 25px;
      font-weight: bold;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: 0.3s;
      font-family: sans-serif;
      text-decoration: none;
      display: inline-block;
    }
    .button-transition:hover {
      background-color: #FA8072;
      color: white;
    }
    .video-box {
      text-align: center;
      margin-top: 40px;
      border: 10px solid white;
      padding: 15px;
      display: inline-block;
      background-color: rgba(255, 255, 255, 0.5);
    }

    /* Guestbook Container Spacing */
    #guestbook-section {
      margin-top: 40px;
      text-align: center;
    }
  </style>
</head>
<body>

<div class="main-wrapper">
